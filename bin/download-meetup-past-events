function fetch_url(string $url): string
{
    $client = new Client([
        'timeout' => 15,
        'headers' => [
            'User-Agent' => 'Mozilla/5.0 (compatible;)',
            'Accept' => 'text/html,application/xhtml+xml',
        ],
    ]);

    $response = $client->get($url);
    $html = $response->getBody()->getContents();

    return $html;
}

function extract_event_data_json(string $html): ?array
{
    $crawler = new Crawler($html);
    $script = $crawler->filter('script#__NEXT_DATA__');

    if ($script->count() === 0) {
        throw new RuntimeException('Could not find __NEXT_DATA__ script tag.');
    }

    $jsonText = $script->text();
    $data = json_decode($jsonText, true, 512, JSON_THROW_ON_ERROR);

    return $data["props"]["pageProps"]["event"];
}

function save_json(array $data, string $filePath): void
{
    $encoded = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);

    if ($encoded === false) {
        throw new RuntimeException('Failed to encode JSON: ' . json_last_error_msg());
    }

    if (file_put_contents($filePath, $encoded) === false) {
        throw new RuntimeException("Failed to write file: $filePath");
    }

    echo "JSON saved to: $filePath\n";
}

function normalize_event_date(string $dateTime): string
{
    $dt = new DateTime($dateTime);
    return $dt->format('Y-m-d');
}


foreach($events as $id) {

    try {
        $url = "https://www.meetup.com/php-valencia/events/{$id}/";
        $html = fetch_url($url);
        $data = extract_event_data_json($html);
        $eventDate = normalize_event_date($data["dateTime"]);
        $targetFile = __DIR__ . "/../meetup_events_data/event_{$eventDate}_{$id}.json";
        save_json($data, $targetFile);
    } catch (Throwable $e) {
        echo "Error: " . $e->getMessage() . "\n";
    }

    
    sleep(1);
}
